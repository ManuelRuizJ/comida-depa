{
  "root": true,
  "extends": ["next/core-web-vitals", "prettier"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "eqeqeq": ["error", "always"],
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs", "tests/**/*.mjs"],
      "env": { "node": true }
    }
  ]
}
